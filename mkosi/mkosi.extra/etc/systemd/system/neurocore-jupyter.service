[Unit]
Description=NeuroCore OS Isolated JupyterLab ML Studio
After=network-online.target neurocore-daemon.service neurocore-mlflow.service
Wants=network-online.target

[Service]
Type=simple
User=neuro
Group=neuro
Slice=neurocore.slice
WorkingDirectory=/home/neuro
Environment=MLFLOW_TRACKING_URI=http://127.0.0.1:5000
# Token authentication remains strictly enabled by default (never empty token)
ExecStart=/opt/ml/envs/python-ml/.venv/bin/jupyter lab \
    --no-browser \
    --ip=127.0.0.1 \
    --port=8888 \
    --ServerApp.root_dir=/home/neuro \
    --ServerApp.allow_remote_access=False \
    --ServerApp.allow_origin=""
Restart=on-failure
RestartSec=5s
MemoryHigh=2G
MemoryMax=3G
CPUWeight=200
TasksMax=512
# Defense-in-depth sandboxing (loopback-only eBPF IP filter; zero capabilities)
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
LockPersonality=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
RestrictNamespaces=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
IPAddressDeny=any
IPAddressAllow=localhost
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @mount @reboot @swap @module @raw-io
SystemCallArchitectures=native
CapabilityBoundingSet=
AmbientCapabilities=
UMask=0077
ReadWritePaths=/home/neuro /var/lib/neurocore/cache

[Install]
WantedBy=multi-user.target
