# Enforce LF line endings for all Linux scripts, configs, kernel patches, and source files
# so Windows + WSL2 checkouts never break shebangs, mkosi, systemd, or patch application.
* text=auto eol=lf

*.sh         text eol=lf
*.py         text eol=lf
*.rs         text eol=lf
*.mojo       text eol=lf
*.h          text eol=lf
*.c          text eol=lf
*.toml       text eol=lf
*.conf       text eol=lf
*.cfg        text eol=lf
*.service    text eol=lf
*.slice      text eol=lf
*.fragment   text eol=lf
*.patch      text eol=lf
*.plymouth   text eol=lf
*.script     text eol=lf
*.yml        text eol=lf
*.yaml       text eol=lf
*.json       text eol=lf
*.ipynb      text eol=lf
*.md         text eol=lf
*.txt        text eol=lf
*.svg        text eol=lf
Makefile     text eol=lf
Kbuild       text eol=lf
*.chroot     text eol=lf
*.sources    text eol=lf

# Binary assets
*.png        binary
*.jpg        binary
*.jpeg       binary
*.gif        binary
*.ppm        binary
*.pf2        binary
*.ico        binary
